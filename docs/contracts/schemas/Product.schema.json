{
  "$defs": {
    "Category": {
      "enum": [
        "suit",
        "shirt",
        "pants",
        "tie",
        "shoes"
      ],
      "title": "Category",
      "type": "string"
    },
    "ColorFamily": {
      "enum": [
        "navy",
        "charcoal",
        "grey",
        "sand",
        "black",
        "white",
        "light_blue",
        "blue_stripe",
        "pink",
        "burgundy",
        "silver",
        "emerald",
        "lavender",
        "brown",
        "cognac",
        "khaki"
      ],
      "title": "ColorFamily",
      "type": "string"
    },
    "Fit": {
      "enum": [
        "slim",
        "regular"
      ],
      "title": "Fit",
      "type": "string"
    },
    "Formality": {
      "description": "Dress-code ladder, ordered from least to most formal.",
      "enum": [
        "smart_casual",
        "business",
        "formal",
        "black_tie"
      ],
      "title": "Formality",
      "type": "string"
    },
    "Occasion": {
      "enum": [
        "casamento",
        "trabalho",
        "entrevista",
        "formatura",
        "gala",
        "evento_diurno",
        "versatil"
      ],
      "title": "Occasion",
      "type": "string"
    },
    "Pattern": {
      "enum": [
        "solid",
        "striped",
        "checked",
        "textured",
        "paisley"
      ],
      "title": "Pattern",
      "type": "string"
    },
    "Season": {
      "enum": [
        "all_year",
        "summer",
        "winter"
      ],
      "title": "Season",
      "type": "string"
    },
    "SizeStock": {
      "additionalProperties": false,
      "properties": {
        "size": {
          "description": "Brazilian size label: suits 46-60, pants 38-54, shirts 1-6, ties U, shoes 37-46.",
          "maxLength": 8,
          "minLength": 1,
          "title": "Size",
          "type": "string"
        },
        "stock": {
          "description": "Units available for try-on.",
          "minimum": 0,
          "title": "Stock",
          "type": "integer"
        }
      },
      "required": [
        "size",
        "stock"
      ],
      "title": "SizeStock",
      "type": "object"
    }
  },
  "description": "A catalog item. Tolerant to extra fields so white-label clients can send richer records.",
  "properties": {
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "sku": {
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[A-Z0-9][A-Z0-9-]+$",
      "title": "Sku",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "description": {
      "default": "",
      "maxLength": 600,
      "title": "Description",
      "type": "string"
    },
    "price_cents": {
      "description": "Price in minor units (integer money).",
      "exclusiveMinimum": 0,
      "title": "Price Cents",
      "type": "integer"
    },
    "currency": {
      "default": "BRL",
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "color": {
      "description": "Human color name, e.g. 'Azul Marinho'.",
      "maxLength": 40,
      "minLength": 1,
      "title": "Color",
      "type": "string"
    },
    "color_family": {
      "$ref": "#/$defs/ColorFamily"
    },
    "pattern": {
      "$ref": "#/$defs/Pattern",
      "default": "solid"
    },
    "fabric": {
      "default": "",
      "maxLength": 80,
      "title": "Fabric",
      "type": "string"
    },
    "style": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "e.g. 'oxford', 'brogue', 'loafer'.",
      "title": "Style"
    },
    "fit_options": {
      "items": {
        "$ref": "#/$defs/Fit"
      },
      "title": "Fit Options",
      "type": "array"
    },
    "formality_tags": {
      "items": {
        "$ref": "#/$defs/Formality"
      },
      "minItems": 1,
      "title": "Formality Tags",
      "type": "array"
    },
    "occasion_tags": {
      "items": {
        "$ref": "#/$defs/Occasion"
      },
      "title": "Occasion Tags",
      "type": "array"
    },
    "seasons": {
      "items": {
        "$ref": "#/$defs/Season"
      },
      "title": "Seasons",
      "type": "array"
    },
    "sizes": {
      "items": {
        "$ref": "#/$defs/SizeStock"
      },
      "minItems": 1,
      "title": "Sizes",
      "type": "array"
    },
    "image_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Url"
    },
    "highlight": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Highlight"
    },
    "available_sizes": {
      "items": {
        "type": "string"
      },
      "readOnly": true,
      "title": "Available Sizes",
      "type": "array"
    },
    "in_stock": {
      "readOnly": true,
      "title": "In Stock",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "sku",
    "name",
    "category",
    "price_cents",
    "color",
    "color_family",
    "formality_tags",
    "sizes",
    "available_sizes",
    "in_stock"
  ],
  "title": "Product",
  "type": "object"
}
