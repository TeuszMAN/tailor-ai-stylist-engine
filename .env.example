# Copy to .env — every variable is optional. With no LLM key the engine runs the
# deterministic rule-based planner, so the full API works right after `git clone`.

# auto | anthropic | openai | none
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ROUNDS=4

# Catalog repository (a catalog sent in the request payload always wins)
# CATALOG_PATH=./data/my_catalog.json
# CATALOG_DATABASE_URL=sqlite:///./catalog.db

# --- HTTP hardening (keep enabled on public deployments) ---
# Comma-separated origins allowed by CORS: put your storefront URL here in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per-client sliding-window limits (429 + Retry-After). The stylist endpoint has its own bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
STYLIST_RATE_LIMIT_PER_MINUTE=20
# Reject request bodies larger than this (413). A 500-product catalog is ~350 KB.
MAX_REQUEST_BYTES=1000000
# Global budget of LLM-backed requests per minute; beyond it, requests run rule-based (no error).
LLM_MAX_REQUESTS_PER_MINUTE=30
# Behind a reverse proxy, uvicorn runs with --proxy-headers: trust the proxy so limits see real client IPs.
# FORWARDED_ALLOW_IPS=*

LOG_LEVEL=INFO
